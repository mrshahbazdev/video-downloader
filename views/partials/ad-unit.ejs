<div class="ad-container my-4 text-center overflow-hidden">
  <% if (adsenseClientId && adsenseClientId !== 'ca-pub-0000000000000000') { %>
  <ins class="adsbygoogle"
       style="display:block"
       data-ad-client="<%= adsenseClientId %>"
       data-ad-slot="<%= adSlot %>"
       data-ad-format="auto"
       data-full-width-responsive="true"></ins>
  <script>
    (function () {
      const consent = localStorage.getItem('cookieConsent');
      if (consent === 'denied') return;
      function pushAd() {
        if (typeof window.adsbygoogle !== 'undefined') {
          (adsbygoogle = window.adsbygoogle || []).push({});
        }
      }
      if (window.adSenseLoaded) {
        pushAd();
      } else if (window.loadAdSense) {
        window.loadAdSense();
        let tries = 0;
        const interval = setInterval(function () {
          tries++;
          if (typeof window.adsbygoogle !== 'undefined') {
            clearInterval(interval);
            pushAd();
          } else if (tries > 20) {
            clearInterval(interval);
          }
        }, 250);
      }
    })();
  </script>
  <% } else { %>
    <div class="ad-placeholder">Ad placeholder — update <code>ADSENSE_CLIENT_ID</code> in your <code>.env</code> file</div>
  <% } %>
</div>
