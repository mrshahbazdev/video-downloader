<div class="ad-container my-4 text-center overflow-hidden">
  <ins class="adsbygoogle"
       style="display:block"
       data-ad-client="<%= adsenseClientId %>"
       data-ad-slot="<%= adSlot %>"
       data-ad-format="auto"
       data-full-width-responsive="true"></ins>
  <% if (adsenseClientId === 'ca-pub-0000000000000000') { %>
    <div class="ad-placeholder">Ad placeholder — update <code>ADSENSE_CLIENT_ID</code> in your <code>.env</code> file</div>
  <% } %>
</div>
<script>
  if (window.ADSENSE_CLIENT_ID && window.ADSENSE_CLIENT_ID !== 'ca-pub-0000000000000000' && typeof window.adsbygoogle !== 'undefined') {
    (adsbygoogle = window.adsbygoogle || []).push({});
  }
</script>
