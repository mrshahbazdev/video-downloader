<div id="cookieBanner" class="fixed bottom-0 left-0 right-0 bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 p-4 shadow-2xl z-50 hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-sm text-slate-600 dark:text-slate-300 text-center sm:text-left">
      We use cookies to store your theme preference and, if enabled, to serve relevant ads through Google. By continuing, you agree to our <a href="/cookie-policy" class="text-sky-600 dark:text-sky-400 hover:underline font-medium">Cookie Policy</a>.
    </p>
    <button id="acceptCookies" class="btn-primary px-5 py-2 text-sm whitespace-nowrap">Accept</button>
  </div>
</div>
<script>
  (function () {
    const banner = document.getElementById('cookieBanner');
    const accept = document.getElementById('acceptCookies');
    if (banner && accept && !localStorage.getItem('cookiesAccepted')) {
      banner.classList.remove('hidden');
      accept.addEventListener('click', () => {
        localStorage.setItem('cookiesAccepted', 'true');
        banner.classList.add('hidden');
      });
    }
  })();
</script>
