<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "<%= siteTitle %>",
  "url": "<%= meta.url.replace(/^(https?:\/\/[^\/]+).*$/, '$1') %>",
  "description": "<%= meta.description.replace(/"/g, '\\"') %>",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "<%= meta.url.replace(/^(https?:\/\/[^\/]+).*$/, '$1') %>/supported-sites?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "<%= siteTitle %>",
  "url": "<%= meta.url.replace(/^(https?:\/\/[^\/]+).*$/, '$1') %>",
  "logo": "<%= meta.url.replace(/^(https?:\/\/[^\/]+).*$/, '$1') %>/favicon.svg",
  "description": "<%= (siteDescription || meta.description).replace(/"/g, '\\"') %>",
  "foundingDate": "2023",
  "sameAs": [],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer support",
    "email": "<%= contactEmail %>",
    "availableLanguage": ["English"]
  },
  "author": {
    "@type": "Person",
    "name": "<%= authorName %>",
    "url": "<%= meta.url.replace(/^(https?:\/\/[^\/]+).*$/, '$1') %>/about",
    "jobTitle": "Editor",
    "worksFor": { "@type": "Organization", "name": "<%= siteTitle %>" }
  },
  "publisher": {
    "@type": "Organization",
    "name": "<%= siteTitle %>",
    "logo": "<%= meta.url.replace(/^(https?:\/\/[^\/]+).*$/, '$1') %>/favicon.svg"
  },
  "about": {
    "@type": "WebPage",
    "name": "About <%= siteTitle %>",
    "url": "<%= meta.url.replace(/^(https?:\/\/[^\/]+).*$/, '$1') %>/about"
  },
  "reviewedBy": {
    "@type": "Person",
    "name": "<%= authorName %>"
  }
}
</script>
