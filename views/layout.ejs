<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <% if (typeof gscVerification !== 'undefined' && gscVerification) { %><meta name="google-site-verification" content="<%= gscVerification %>" /><% } %>
  <% if (typeof bingVerification !== 'undefined' && bingVerification) { %><meta name="msvalidate.01" content="<%= bingVerification %>" /><% } %>
  <title><%= meta.title %></title>
  <meta name="description" content="<%= meta.description %>" />
  <% if (meta.keywords) { %><meta name="keywords" content="<%= meta.keywords %>" /><% } %>
  <% if (meta.robots) { %><meta name="robots" content="<%= meta.robots %>" /><% } %>
  <meta property="og:title" content="<%= meta.title %>" />
  <meta property="og:description" content="<%= meta.description %>" />
  <meta property="og:image" content="<%= meta.image %>" />
  <meta property="og:url" content="<%= meta.url %>" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= meta.title %>" />
  <meta name="twitter:description" content="<%= meta.description %>" />
  <meta name="twitter:image" content="<%= meta.image %>" />
  <link rel="canonical" href="<%= meta.url %>" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
  <link rel="preconnect" href="https://googleads.g.doubleclick.net" crossorigin />
  <link rel="dns-prefetch" href="https://ep1.adtrafficquality.google" />
  <%- include('partials/styles') %>
  <style>
    a[href].text-sky-600, a[href] .text-sky-600, .prose a[href] { color: #0369a1; text-decoration: underline; }
    a[href].text-sky-600:hover, a[href] .text-sky-600:hover, .prose a[href]:hover { color: #075985; }
    .dark a[href].text-sky-600, .dark a[href] .text-sky-600, .dark .prose a[href] { color: #7dd3fc; }
    .dark a[href].text-sky-600:hover, .dark a[href] .text-sky-600:hover, .dark .prose a[href]:hover { color: #bae6fd; }
    a[href].btn-primary, a[href].btn-secondary, a[href].no-underline, a[href].card { text-decoration: none; }
  </style>
  <%- include('partials/ads') %>
  <%- include('partials/structured-data') %>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100 antialiased flex flex-col min-h-screen">
  <%- include('partials/nav') %>
  <%- include('partials/breadcrumb') %>
  <main class="flex-grow">
    <%- body %>
  </main>
  <% if (typeof post === 'undefined') { %><%- include('partials/page-info') %><% } %>
  <% if (typeof post === 'undefined' && (typeof hasFaq === 'undefined' || !hasFaq)) { %><%- include('partials/faq') %><% } %>
  <%- include('partials/article-schema') %>
  <%- include('partials/footer') %>
  <%- include('partials/cookie-banner') %>
  <%- include('partials/scripts') %>
</body>
</html>
