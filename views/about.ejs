<section class="bg-white dark:bg-slate-900 py-16">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-4xl font-bold text-slate-900 dark:text-white mb-6 text-center">About <%= siteTitle %></h1>

    <%- include('partials/ad-unit', { adSlot: 'about-top' }) %>

    <div class="prose dark:prose-invert max-w-none">
      <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        <%= siteTitle %> is a free, privacy-focused online video downloader designed to help users save publicly accessible videos from thousands of supported websites. We believe downloading your own content, public domain media, or creator-approved videos should be simple, fast, and transparent.
      </p>
      <p class="text-slate-600 dark:text-slate-400 leading-relaxed mt-4">
        The service is built on open-source technologies, including Node.js, Express, and <a href="https://github.com/yt-dlp/yt-dlp" target="_blank" rel="noopener noreferrer" class="text-sky-600 dark:text-sky-400 hover:underline">yt-dlp</a>, which powers the extraction layer for 1000+ platforms.
      </p>
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-8 mb-4">Our Values</h2>
      <ul class="list-disc pl-6 space-y-2 text-slate-600 dark:text-slate-400">
        <li><strong>Privacy:</strong> No user accounts, no tracking pixels, and no long-term storage of downloaded files.</li>
        <li><strong>Transparency:</strong> Clear legal pages, disclaimers, and open-source tooling.</li>
        <li><strong>Speed:</strong> Lightweight server-side processing that returns results quickly.</li>
        <li><strong>Responsibility:</strong> We actively discourage piracy and require users to follow local copyright laws.</li>
      </ul>
    </div>

    <%- include('partials/ad-unit', { adSlot: 'about-bottom' }) %>
  </div>
</section>
