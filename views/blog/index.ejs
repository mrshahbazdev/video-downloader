<section class="bg-slate-50 dark:bg-slate-950 py-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 dark:text-white mb-4">Video Downloading Guides</h1>
      <p class="text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
        Original tutorials and tips for downloading videos from YouTube, TikTok, Instagram, Facebook, Twitter/X, Vimeo, and 1000+ supported sites.
      </p>
    </div>

    <%- include('../partials/ad-unit', { adSlot: 'blog-top' }) %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-10">
      <% blogPosts.forEach(function(post) { %>
        <a href="/blog/<%= post.slug %>" class="card card-hover group">
          <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition"><%= post.title %></h2>
          <p class="text-slate-600 dark:text-slate-400 text-sm"><%= post.summary || post.description %></p>
          <span class="inline-flex mt-4 text-sm font-semibold text-sky-600 dark:text-sky-400">Read guide &rarr;</span>
        </a>
      <% }); %>
    </div>

    <div class="mt-16">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">Tool Guides (<%= toolGuides.length %>+)</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% toolGuides.forEach(function(tool) { %>
          <a href="/blog/<%= tool.slug %>" class="card card-hover group" title="<%= tool.title %> guide">
            <div class="flex items-start gap-4">
              <span class="text-2xl"><%= tool.icon %></span>
              <div>
                <h3 class="font-bold text-base mb-1 text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition"><%= tool.title %> Guide</h3>
                <p class="text-sm text-slate-600 dark:text-slate-400 line-clamp-2"><%= tool.desc %></p>
              </div>
            </div>
          </a>
        <% }); %>
      </div>
    </div>

    <%- include('../partials/ad-unit', { adSlot: 'blog-bottom' }) %>
  </div>
</section>
