<section class="bg-slate-50 dark:bg-slate-950 py-16">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-500 dark:text-slate-400 mb-4">
      <a href="/" class="hover:underline text-sky-600 dark:text-sky-400">Home</a>
      <span class="mx-2">/</span>
      <a href="/blog" class="hover:underline text-sky-600 dark:text-sky-400">Guides</a>
      <span class="mx-2">/</span>
      <span class="font-medium"><%= post.site %> Guide</span>
    </nav>

    <article>
      <header class="mb-8">
        <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 dark:text-white mb-4"><%= post.title %></h1>
        <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed mb-4"><%= post.summary %></p>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          Published on <time datetime="<%= post.date %>"><%= post.date %></time>
          <% if (post.dateModified && post.dateModified !== post.date) { %>
            · Updated <time datetime="<%= post.dateModified %>"><%= post.dateModified %></time>
          <% } %>
          · By <%= post.author %>
        </p>
      </header>

      <%- include('../partials/ad-unit', { adSlot: 'blog-top' }) %>

      <div class="prose dark:prose-invert max-w-none">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">How to Download <%= post.site %> Videos with <%= siteTitle %></h2>
        <ol class="list-decimal pl-5 space-y-2 text-slate-600 dark:text-slate-300" id="step-1">
          <li>Open the <%= post.site %> video in your browser or app and copy the link.</li>
          <li>Go to the <a href="/" class="text-sky-600 dark:text-sky-400 hover:underline"><%= siteTitle %> home page</a>.</li>
          <li>Paste the URL into the input box and click <strong>Get Video</strong>.</li>
          <li id="formats">Wait for the format list, then choose <%= post.formats %>.</li>
          <li id="download">Click the format card and your <%= post.site %> download starts on the same page.</li>
        </ol>

        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">Why Use <%= siteTitle %> for <%= post.site %>?</h2>
        <ul class="list-disc pl-5 space-y-2 text-slate-600 dark:text-slate-300">
          <li>No software installation required — works in any browser.</li>
          <li>Supports HD and high-quality formats when available.</li>
          <li>Fast processing with yt-dlp and browser impersonation.</li>
          <li>Privacy focused — we do not store your downloads.</li>
          <li>Free to use for videos you own or have permission to download.</li>
        </ul>

        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">Frequently Asked Questions</h2>
        <div class="space-y-4" id="faq">
          <details class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-4">
            <summary class="font-semibold text-slate-900 dark:text-white cursor-pointer">Is it free to download <%= post.site %> videos?</summary>
            <p class="mt-3 text-slate-600 dark:text-slate-300 text-sm">Yes. <%= siteTitle %> is free to use. Just paste the <%= post.site %> URL and pick a format.</p>
          </details>
          <details class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-4">
            <summary class="font-semibold text-slate-900 dark:text-white cursor-pointer">What formats are available for <%= post.site %>?</summary>
            <p class="mt-3 text-slate-600 dark:text-slate-300 text-sm">You can usually choose <%= post.formats %>, depending on the original upload.</p>
          </details>
          <details class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-4">
            <summary class="font-semibold text-slate-900 dark:text-white cursor-pointer">Can I use this on mobile?</summary>
            <p class="mt-3 text-slate-600 dark:text-slate-300 text-sm">Yes, <%= siteTitle %> works on phones, tablets, and desktops without installing any app.</p>
          </details>
          <details class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-4">
            <summary class="font-semibold text-slate-900 dark:text-white cursor-pointer">Is downloading <%= post.site %> videos legal?</summary>
            <p class="mt-3 text-slate-600 dark:text-slate-300 text-sm">Only download content you own or have permission to use. Respect copyright and each platform's terms.</p>
          </details>
        </div>

        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">Responsible Downloading</h2>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
          <%= siteTitle %> is a neutral educational utility. Always follow local copyright laws and the terms of the platform hosting the video. If you are unsure whether you have permission to download a specific video, contact the rights holder or use the platform's official offline features.
        </p>
      </div>

      <%- include('../partials/ad-unit', { adSlot: 'blog-bottom' }) %>

      <div class="mt-12 text-center">
        <a href="/" class="btn-primary">Try the <%= siteTitle %> Downloader</a>
        <% if (post.slug) { %>
          <a href="/<%= post.slug %>" class="btn-primary ml-2">Go to <%= post.site %> Tool</a>
        <% } %>
      </div>
    </article>
  </div>
</section>
