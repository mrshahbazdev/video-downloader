<section class="gradient-hero relative overflow-hidden">
  <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 20% 30%, rgba(255,255,255,0.2) 0%, transparent 25%), radial-gradient(circle at 80% 70%, rgba(255,255,255,0.15) 0%, transparent 25%);"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 relative">
    <div class="text-center max-w-3xl mx-auto">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight mb-6">
        Free Video <span class="text-sky-300">Downloader Tools</span>
      </h1>
      <p class="text-lg sm:text-xl text-slate-200">
        A collection of fast, free, and privacy-friendly tools for downloading videos, audio, and more from 1000+ sites.
      </p>
    </div>
  </div>
</section>

<section class="py-16 bg-white dark:bg-slate-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% (tools || []).forEach(function(tool) { %>
        <a href="<%= tool.link || (tool.slug ? '/' + tool.slug : '/') %>" class="card card-hover group">
          <div class="flex items-start gap-4">
            <span class="text-3xl"><%= tool.icon %></span>
            <div>
              <h3 class="font-bold text-lg mb-2 text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition"><%= tool.title %></h3>
              <p class="text-sm text-slate-600 dark:text-slate-400"><%= tool.desc %></p>
            </div>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>
