<section class="gradient-hero relative overflow-hidden">
  <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 20% 30%, rgba(255,255,255,0.2) 0%, transparent 25%), radial-gradient(circle at 80% 70%, rgba(255,255,255,0.15) 0%, transparent 25%);"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 relative">
    <div class="text-center max-w-3xl mx-auto">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/10 text-sky-100 text-xs font-medium mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Free & fast
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight mb-6">
        <%= toolTitle %>
      </h1>
      <p class="text-lg sm:text-xl text-slate-200 mb-10">
        <%= toolDesc %>
      </p>

      <%- include('partials/downloader-form', { placeholder: toolPlaceholder, buttonText: 'Get Video' }) %>
    </div>
  </div>
</section>

<section class="py-16 bg-white dark:bg-slate-900">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">How to use this tool</h2>
    <p class="text-slate-600 dark:text-slate-400 mb-8">Copy the link, paste it above, pick your format, and download instantly.</p>
    <a href="/" class="btn-primary">Try the all-in-one downloader</a>
  </div>
</section>

<section class="py-12 bg-slate-50 dark:bg-slate-800">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-6">
      <a href="/blog/<%= toolSlug %>" class="text-sky-600 dark:text-sky-400 hover:underline font-medium" rel="nofollow">Read the full guide: <%= toolTitle %> →</a>
    </div>
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">What is <%= toolTitle %>?</h2>
    <p class="text-slate-600 dark:text-slate-400 mb-6 leading-relaxed">
      <%= toolTitle %> is a free, fast, and privacy-friendly online downloader. Paste a public video URL and save your favorite clips in MP4, MP3, or other available formats. It works on desktop, mobile, and tablet without requiring any registration or software installation.
    </p>
    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">Why use <%= toolTitle %>?</h3>
    <ul class="list-disc list-inside text-slate-600 dark:text-slate-400 mb-6 space-y-2">
      <li>100% free with no hidden charges</li>
      <li>Works with 1000+ supported video sites</li>
      <li>Download videos in HD, 4K, or extract audio as MP3</li>
      <li>Simple math captcha keeps bots away</li>
      <li>No signup, no app install needed</li>
      <li>Safe downloads via signed proxy tokens</li>
    </ul>
    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">How to download in 3 steps</h3>
    <ol class="list-decimal list-inside text-slate-600 dark:text-slate-400 mb-6 space-y-2">
      <li>Copy the URL of the video you want to download.</li>
      <li>Paste it into the input box and complete the captcha.</li>
      <li>Choose your preferred format and click the download button.</li>
    </ol>
    <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
      <%= toolTitle %> supports YouTube, TikTok, Instagram, Facebook, Twitter/X, Vimeo, Dailymotion, Twitch, SoundCloud, and hundreds more platforms. Always respect copyright and only download content you have permission to save.
    </p>

    <div class="mt-8 p-4 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-xl">
      <p class="text-sm text-amber-800 dark:text-amber-200 font-medium">
        Copyright notice: Only download videos you created, own, or have explicit permission to save. Redistributing copyrighted content is prohibited. See our <a href="/content-policy" class="underline hover:text-amber-600 dark:hover:text-amber-300">Content Policy</a> for details.
      </p>
    </div>
  </div>
</section>

<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": meta.title,
  "url": meta.url,
  "description": meta.description,
  "isPartOf": {
    "@type": "WebSite",
    "name": siteTitle,
    "url": meta.url.replace(/^(https?:\/\/[^\/]+).*$/, '$1')
  }
}) %>
</script>

<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": meta.url.replace(/^(https?:\/\/[^\/]+).*$/, '$1') },
    { "@type": "ListItem", "position": 2, "name": "Tools", "item": meta.url.replace(/^(https?:\/\/[^\/]+).*$/, '$1') + "/tools" },
    { "@type": "ListItem", "position": 3, "name": toolTitle }
  ]
}) %>
</script>

<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": toolTitle,
  "url": meta.url,
  "description": toolDesc,
  "applicationCategory": "MultimediaApplication",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "operatingSystem": "Any",
  "author": { "@type": "Organization", "name": siteTitle, "url": meta.url.replace(/^(https?:\/\/[^\/]+).*$/, '$1') },
  "publisher": { "@type": "Organization", "name": siteTitle, "url": meta.url.replace(/^(https?:\/\/[^\/]+).*$/, '$1') }
}) %>
</script>

<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": `How to use ${toolTitle}`,
  "description": toolDesc,
  "totalTime": "PT2M",
  "supply": [{ "@type": "HowToSupply", "name": "Public video URL" }],
  "tool": [{ "@type": "HowToTool", "name": toolTitle, "url": meta.url }],
  "step": [
    { "@type": "HowToStep", "name": "Copy the URL", "text": `Copy the public video link from the site you want to download from.`, "url": meta.url + '#step-1' },
    { "@type": "HowToStep", "name": "Paste and analyze", "text": `Paste the URL into the ${toolTitle} input box and click the button.`, "url": meta.url },
    { "@type": "HowToStep", "name": "Pick a format", "text": "Choose MP4, MP3, or the best available quality from the list.", "url": meta.url + '#formats' },
    { "@type": "HowToStep", "name": "Download", "text": "Click the format card and save the file to your device.", "url": meta.url + '#download' }
  ]
}) %>
</script>

<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": `Is ${toolTitle} free?`, "acceptedAnswer": { "@type": "Answer", "text": `Yes. ${siteTitle} is free to use. Just paste the URL and pick a format.` } },
    { "@type": "Question", "name": `What formats does ${toolTitle} support?`, "acceptedAnswer": { "@type": "Answer", "text": "It supports MP4, MP3, HD, 4K, and other formats when available from the original source." } },
    { "@type": "Question", "name": `Can I use ${toolTitle} on mobile?`, "acceptedAnswer": { "@type": "Answer", "text": "Yes. It works on phones, tablets, and desktops without installing any app." } },
    { "@type": "Question", "name": `Is ${toolTitle} safe and legal?`, "acceptedAnswer": { "@type": "Answer", "text": "Only download content you own or have permission to use. Respect copyright and platform terms." } }
  ]
}) %>
</script>

<% if (captchaMode === 'recaptcha') { %>
  <script src="https://www.google.com/recaptcha/api.js?render=<%= recaptchaSiteKey %>" async defer></script>
<% } %>
<script>
  window.CAPTCHA_MODE = '<%= captchaMode %>';
  window.RECAPTCHA_SITE_KEY = '<%= recaptchaSiteKey %>';
</script>
<script src="/js/downloader.js?v=<%= assetVersion %>" defer></script>
