<section class="gradient-hero relative overflow-hidden">
  <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 20% 30%, rgba(255,255,255,0.2) 0%, transparent 25%), radial-gradient(circle at 80% 70%, rgba(255,255,255,0.15) 0%, transparent 25%);"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 relative">
    <div class="text-center max-w-3xl mx-auto">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight mb-6">
        Download Videos from <span class="text-sky-300">1000+ Sites</span>
      </h1>
      <p class="text-lg sm:text-xl text-slate-200 mb-10">
        Fast, free, and privacy-friendly online video downloader for YouTube, TikTok, Instagram, Twitter, Facebook, Vimeo, Dailymotion, and more.
      </p>

      <div class="glass rounded-2xl p-4 sm:p-6 max-w-2xl mx-auto shadow-2xl">
        <div class="flex flex-col sm:flex-row gap-3">
          <input type="text" id="url" class="input-url flex-1" placeholder="Paste video URL here..." />
          <button id="infoBtn" class="btn-primary whitespace-nowrap">
            <span id="infoBtnText">Get Video</span>
          </button>
        </div>
        <button type="button" id="advancedToggle" class="text-xs text-sky-300 hover:text-white mt-3 text-left underline">
          Advanced options
        </button>
        <div id="advancedOptions" class="hidden mt-3 text-left space-y-3">
          <div>
            <label for="cookies" class="block text-xs text-slate-300 mb-1">Site cookies (Netscape format)</label>
          <textarea id="cookies" rows="3" class="input-url text-xs font-mono" placeholder="# Netscape HTTP Cookie File\nyoutube.com\tTRUE\t/\tFALSE\t...\n..."></textarea>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="poToken" class="block text-xs text-slate-300 mb-1">YouTube PO token</label>
              <input type="text" id="poToken" class="input-url text-xs font-mono" placeholder="web+M..." />
            </div>
            <div>
              <label for="visitorData" class="block text-xs text-slate-300 mb-1">YouTube visitor data</label>
              <input type="text" id="visitorData" class="input-url text-xs font-mono" placeholder="Cgt..." />
            </div>
          </div>
          <p class="text-xs text-slate-400">Cookies or PO token are optional, but YouTube may require them on some server IPs.</p>
        </div>
        <p class="text-xs text-slate-300 mt-3 text-left">
          By using this service you agree to our <a href="/terms" class="underline hover:text-sky-300">Terms</a> and <a href="/disclaimer" class="underline hover:text-sky-300">Disclaimer</a>.
        </p>
      </div>

      <div id="message" class="mt-4 text-left hidden"></div>

      <div id="infoCard" class="hidden mt-6 text-left">
        <div class="card bg-white/95 dark:bg-slate-900/95">
          <div class="flex flex-col md:flex-row gap-6">
            <img id="thumb" src="" alt="thumbnail" class="w-full md:w-64 rounded-xl object-cover aspect-video bg-slate-200 dark:bg-slate-800" />
            <div class="flex-1">
              <h2 id="title" class="text-2xl font-bold text-slate-900 dark:text-white mb-2"></h2>
              <p id="meta" class="text-slate-600 dark:text-slate-400 mb-4"></p>
              <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-3">All available formats</h3>
              <div id="formatList" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 max-h-80 overflow-y-auto pr-1"></div>
              <div id="downloadResult" class="hidden mt-4 flex items-center gap-3 flex-wrap">
                <a id="downloadLink" class="btn-primary bg-emerald-500 hover:bg-emerald-600 shadow-emerald-500/30" href="#" target="_blank">Open file</a>
                <span id="downloadFilename" class="text-sm text-slate-600 dark:text-slate-400"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%- include('partials/ad-unit', { adSlot: 'home-top' }) %>
</div>

<section class="py-16 bg-white dark:bg-slate-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-4">Why use <%= siteTitle %>?</h2>
      <p class="text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">A clean, modern downloader that puts privacy and speed first.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="card text-center">
        <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-sky-100 dark:bg-sky-900/30 flex items-center justify-center text-sky-600 dark:text-sky-400 text-2xl">🌐</div>
        <h3 class="font-bold text-lg mb-2">1000+ Sites</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400">YouTube, TikTok, Instagram, Facebook, Twitter/X, Vimeo, Reddit, and many more.</p>
      </div>
      <div class="card text-center">
        <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 text-2xl">🔒</div>
        <h3 class="font-bold text-lg mb-2">Privacy First</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400">No account required. We don't store your history or downloaded content longer than needed.</p>
      </div>
      <div class="card text-center">
        <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center text-amber-600 dark:text-amber-400 text-2xl">⚡</div>
        <h3 class="font-bold text-lg mb-2">Fast & Simple</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400">Paste a URL, pick a format, and download in seconds with our streamlined workflow.</p>
      </div>
      <div class="card text-center">
        <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-violet-100 dark:bg-violet-900/30 flex items-center justify-center text-violet-600 dark:text-violet-400 text-2xl">📱</div>
        <h3 class="font-bold text-lg mb-2">Mobile Friendly</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400">Works perfectly on phones, tablets, and desktops without installing anything.</p>
      </div>
    </div>
  </div>
</section>

<section class="py-16 bg-slate-50 dark:bg-slate-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-4">Supported Platforms</h2>
      <p class="text-slate-600 dark:text-slate-400">Just a few of the popular platforms we support via yt-dlp.</p>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
      <% ['YouTube','TikTok','Instagram','Facebook','Twitter/X','Vimeo','Dailymotion','Reddit','Twitch','SoundCloud','Bilibili','TED'].forEach(function(site) { %>
        <div class="card flex items-center justify-center h-20 font-semibold text-slate-700 dark:text-slate-200"><%= site %></div>
      <% }); %>
    </div>
    <div class="text-center mt-8">
      <a href="/supported-sites" class="btn-primary">View All Supported Sites</a>
    </div>
  </div>
</section>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <%- include('partials/ad-unit', { adSlot: 'home-middle' }) %>
</div>

<section class="py-16 bg-white dark:bg-slate-900">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-4">How It Works</h2>
      <p class="text-slate-600 dark:text-slate-400">Three simple steps to save your favorite videos.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="card text-center relative">
        <span class="absolute -top-4 -left-4 w-10 h-10 rounded-full bg-sky-600 text-white flex items-center justify-center font-bold">1</span>
        <h3 class="font-bold text-lg mt-2 mb-2">Paste URL</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400">Copy the video link from your browser or app and paste it above.</p>
      </div>
      <div class="card text-center relative">
        <span class="absolute -top-4 -left-4 w-10 h-10 rounded-full bg-sky-600 text-white flex items-center justify-center font-bold">2</span>
        <h3 class="font-bold text-lg mt-2 mb-2">Pick Format</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400">Preview details and select the quality or format that fits your needs.</p>
      </div>
      <div class="card text-center relative">
        <span class="absolute -top-4 -left-4 w-10 h-10 rounded-full bg-sky-600 text-white flex items-center justify-center font-bold">3</span>
        <h3 class="font-bold text-lg mt-2 mb-2">Download</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400">Hit download and get your video file in seconds.</p>
      </div>
    </div>
  </div>
</section>

<section class="py-16 bg-slate-50 dark:bg-slate-950">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-4">Frequently Asked Questions</h2>
    </div>
    <div class="space-y-4" x-data="{ open: null }">
      <% [
        { q: 'Is this downloader free to use?', a: 'Yes. The core downloader is free to use. Ads help keep the service running.' },
        { q: 'Do I need to install any software?', a: 'No. Everything works in your browser. We also offer a CLI for power users.' },
        { q: 'Which sites are supported?', a: 'We support 1000+ sites via yt-dlp, including YouTube, TikTok, Instagram, Facebook, Twitter/X, Vimeo, Dailymotion, Reddit, and more.' },
        { q: 'Is downloading videos legal?', a: 'You should only download content you own or have permission to use. See our Disclaimer for details.' }
      ].forEach(function(item, idx) { %>
        <div class="card">
          <button class="flex justify-between items-center w-full text-left font-semibold" onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180')">
            <%= item.q %>
            <svg class="w-5 h-5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <p class="hidden mt-3 text-slate-600 dark:text-slate-400 text-sm"><%= item.a %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="py-16 bg-gradient-to-br from-sky-600 to-blue-700 text-white text-center">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold mb-4">Ready to download your first video?</h2>
    <p class="text-sky-100 mb-8">Paste a URL at the top of the page and get started in seconds.</p>
    <a href="#" onclick="document.getElementById('url').focus(); window.scrollTo({top:0, behavior:'smooth'}); return false;" class="inline-block px-8 py-3 rounded-xl bg-white text-sky-700 font-bold hover:bg-sky-50 transition">Try It Now</a>
  </div>
</section>

<script src="/js/downloader.js"></script>
