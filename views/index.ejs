<section class="gradient-hero relative overflow-hidden">
  <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 20% 30%, rgba(255,255,255,0.2) 0%, transparent 25%), radial-gradient(circle at 80% 70%, rgba(255,255,255,0.15) 0%, transparent 25%);"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 relative">
    <div class="text-center max-w-3xl mx-auto">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/10 text-sky-100 text-xs font-medium mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        1000+ sites supported
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight mb-6">
        Download Videos from <span class="text-sky-300">1000+ Sites</span>
      </h1>
      <p class="text-lg sm:text-xl text-slate-200 mb-10">
        Paste a link and pick the format you want. Free, fast, and privacy-friendly.
      </p>

      <%- include('partials/downloader-form', { placeholder: 'Paste video URL here...', buttonText: 'Get Video' }) %>
    </div>
  </div>
</section>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%- include('partials/ad-unit', { adSlot: 'home-top' }) %>
</div>

<section class="py-20 bg-white dark:bg-slate-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-4">Why use <%= siteTitle %>?</h2>
      <p class="text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">A clean, modern downloader that puts privacy and speed first.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="card card-hover text-center">
        <div class="w-14 h-14 mx-auto mb-5 rounded-2xl bg-sky-100 dark:bg-sky-900/30 flex items-center justify-center text-sky-600 dark:text-sky-400 text-2xl">🌐</div>
        <h3 class="font-bold text-lg mb-2">1000+ Sites</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400">YouTube, TikTok, Instagram, Facebook, Twitter/X, Vimeo, Reddit, and many more.</p>
      </div>
      <div class="card card-hover text-center">
        <div class="w-14 h-14 mx-auto mb-5 rounded-2xl bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 text-2xl">🔒</div>
        <h3 class="font-bold text-lg mb-2">Privacy First</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400">No account required. We don't store your history or downloaded content longer than needed.</p>
      </div>
      <div class="card card-hover text-center">
        <div class="w-14 h-14 mx-auto mb-5 rounded-2xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center text-amber-600 dark:text-amber-400 text-2xl">⚡</div>
        <h3 class="font-bold text-lg mb-2">Fast & Simple</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400">Paste a URL, pick a format, and download in seconds with our streamlined workflow.</p>
      </div>
      <div class="card card-hover text-center">
        <div class="w-14 h-14 mx-auto mb-5 rounded-2xl bg-violet-100 dark:bg-violet-900/30 flex items-center justify-center text-violet-600 dark:text-violet-400 text-2xl">📱</div>
        <h3 class="font-bold text-lg mb-2">Mobile Friendly</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400">Works perfectly on phones, tablets, and desktops without installing anything.</p>
      </div>
    </div>
  </div>
</section>

<section class="py-20 bg-slate-50 dark:bg-slate-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-4">Supported Platforms</h2>
      <p class="text-slate-600 dark:text-slate-400">Just a few of the popular platforms we support via yt-dlp.</p>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
      <% ['YouTube','TikTok','Instagram','Facebook','Twitter/X','Vimeo','Dailymotion','Reddit','Twitch','SoundCloud','Bilibili','TED'].forEach(function(site) { %>
        <div class="card card-hover flex items-center justify-center h-20 font-semibold text-slate-700 dark:text-slate-200"><%= site %></div>
      <% }); %>
    </div>
    <div class="text-center mt-10">
      <a href="/supported-sites" class="btn-primary">View All Supported Sites</a>
    </div>
  </div>
</section>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <%- include('partials/ad-unit', { adSlot: 'home-middle' }) %>
</div>

<section class="py-20 bg-white dark:bg-slate-900">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-4">How It Works</h2>
      <p class="text-slate-600 dark:text-slate-400">Three simple steps to save your favorite videos.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="card card-hover text-center relative">
        <span class="absolute -top-5 -left-3 w-12 h-12 rounded-full bg-gradient-to-br from-sky-500 to-blue-600 text-white flex items-center justify-center font-bold shadow-lg">1</span>
        <h3 class="font-bold text-lg mt-2 mb-2">Paste URL</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400">Copy the video link from your browser or app and paste it above.</p>
      </div>
      <div class="card card-hover text-center relative">
        <span class="absolute -top-5 -left-3 w-12 h-12 rounded-full bg-gradient-to-br from-sky-500 to-blue-600 text-white flex items-center justify-center font-bold shadow-lg">2</span>
        <h3 class="font-bold text-lg mt-2 mb-2">Pick Format</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400">Preview details and select the quality or format that fits your needs.</p>
      </div>
      <div class="card card-hover text-center relative">
        <span class="absolute -top-5 -left-3 w-12 h-12 rounded-full bg-gradient-to-br from-sky-500 to-blue-600 text-white flex items-center justify-center font-bold shadow-lg">3</span>
        <h3 class="font-bold text-lg mt-2 mb-2">Download</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400">Hit a format card and get your video file in seconds.</p>
      </div>
    </div>
  </div>
</section>

<section class="py-20 bg-slate-50 dark:bg-slate-950">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-4">Frequently Asked Questions</h2>
    </div>
    <div class="space-y-4">
      <% [
        { q: 'Is this downloader free to use?', a: 'Yes. The core downloader is free to use. Ads help keep the service running.' },
        { q: 'Do I need to install any software?', a: 'No. Everything works in your browser. We also offer a CLI for power users.' },
        { q: 'Which sites are supported?', a: 'We support 1000+ sites via yt-dlp, including YouTube, TikTok, Instagram, Facebook, Twitter/X, Vimeo, Dailymotion, Reddit, and more.' },
        { q: 'Is downloading videos legal?', a: 'You should only download content you own or have permission to use. See our Disclaimer for details.' }
      ].forEach(function(item) { %>
        <div class="card card-hover">
          <button class="flex justify-between items-center w-full text-left font-semibold gap-3" onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180')">
            <%= item.q %>
            <svg class="w-5 h-5 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <p class="hidden mt-3 text-slate-600 dark:text-slate-400 text-sm"><%= item.a %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="py-20 bg-gradient-to-br from-sky-600 to-blue-700 text-white text-center">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold mb-4">Ready to download your first video?</h2>
    <p class="text-sky-100 mb-8">Paste a URL at the top of the page and get started in seconds.</p>
    <a href="#" onclick="document.getElementById('url').focus(); window.scrollTo({top:0, behavior:'smooth'}); return false;" class="inline-block px-8 py-3 rounded-2xl bg-white text-sky-700 font-bold hover:bg-sky-50 transition shadow-xl">Try It Now</a>
  </div>
</section>

<% if (captchaMode === 'recaptcha') { %>
  <script src="https://www.google.com/recaptcha/api.js?render=<%= recaptchaSiteKey %>" async defer></script>
<% } %>
<script>
  window.CAPTCHA_MODE = '<%= captchaMode %>';
  window.RECAPTCHA_SITE_KEY = '<%= recaptchaSiteKey %>';
</script>
<script src="/js/downloader.js?v=<%= Date.now() %>"></script>
