<h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-4">Blog Posts</h1>
<p class="text-slate-600 dark:text-slate-400 mb-6"><%= total %> static posts.</p>

<form method="GET" class="mb-6 flex gap-3">
  <input type="text" name="q" value="<%= q %>" placeholder="Search posts..." class="input-url max-w-md" />
  <button type="submit" class="btn-primary">Search</button>
  <a href="/admin/blog" class="btn-primary bg-slate-600">Reset</a>
</form>

<div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800">
  <table class="w-full text-left text-sm">
    <thead class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
      <tr>
        <th class="px-4 py-3 font-semibold">Title</th>
        <th class="px-4 py-3 font-semibold">Slug</th>
        <th class="px-4 py-3 font-semibold">Site</th>
        <th class="px-4 py-3 font-semibold text-right">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
      <% posts.forEach(function(post) { %>
        <tr class="bg-white dark:bg-slate-900">
          <td class="px-4 py-3 text-slate-900 dark:text-slate-100 font-medium"><%= post.title %></td>
          <td class="px-4 py-3 text-slate-600 dark:text-slate-400"><%= post.slug %></td>
          <td class="px-4 py-3 text-slate-600 dark:text-slate-400"><%= post.site %></td>
          <td class="px-4 py-3 text-right space-x-2">
            <a href="/blog/<%= post.slug %>" target="_blank" class="text-sky-600 dark:text-sky-400 hover:underline">View</a>
            <form action="/admin/blog/<%= encodeURIComponent(post.slug) %>/delete" method="POST" class="inline" onsubmit="return confirm('Delete this post?')">
              <button type="submit" class="text-rose-600 dark:text-rose-400 hover:underline">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<% if (totalPages > 1) { %>
  <div class="mt-8 flex justify-center gap-2 text-sm">
    <% if (page > 1) { %>
      <a href="?q=<%= encodeURIComponent(q) %>&page=<%= page - 1 %>" class="px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800">Prev</a>
    <% } %>
    <span class="px-3 py-2 rounded-lg bg-sky-100 dark:bg-sky-900/30 text-sky-700 dark:text-sky-300">Page <%= page %> of <%= totalPages %></span>
    <% if (page < totalPages) { %>
      <a href="?q=<%= encodeURIComponent(q) %>&page=<%= page + 1 %>" class="px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800">Next</a>
    <% } %>
  </div>
<% } %>
