<h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-4">Tools Catalog</h1>
<p class="text-slate-600 dark:text-slate-400 mb-6"><%= total %> tools. Search and edit titles, descriptions, and placeholders.</p>

<form method="GET" class="mb-6 flex gap-3">
  <input type="text" name="q" value="<%= q %>" placeholder="Search tools..." class="input-url max-w-md" />
  <button type="submit" class="btn-primary">Search</button>
  <a href="/admin/tools" class="btn-primary bg-slate-600">Reset</a>
</form>

<div class="space-y-4">
  <% tools.forEach(function(tool) { %>
    <form action="/admin/tools/<%= encodeURIComponent(tool.slug || tool.link) %>" method="POST" class="card p-4 grid grid-cols-1 md:grid-cols-12 gap-4 items-start">
      <div class="md:col-span-3">
        <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Title</label>
        <input type="text" name="title" value="<%= tool.title %>" class="input-url" />
      </div>
      <div class="md:col-span-5">
        <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Description</label>
        <input type="text" name="desc" value="<%= tool.desc %>" class="input-url" />
      </div>
      <div class="md:col-span-3">
        <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Placeholder</label>
        <input type="text" name="placeholder" value="<%= tool.placeholder || '' %>" class="input-url" />
      </div>
      <div class="md:col-span-1 flex items-end">
        <button type="submit" class="btn-primary w-full text-sm py-2.5">Save</button>
      </div>
    </form>
  <% }) %>
</div>

<% if (totalPages > 1) { %>
  <div class="mt-8 flex justify-center gap-2 text-sm">
    <% if (page > 1) { %>
      <a href="?q=<%= encodeURIComponent(q) %>&page=<%= page - 1 %>" class="px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800">Prev</a>
    <% } %>
    <span class="px-3 py-2 rounded-lg bg-sky-100 dark:bg-sky-900/30 text-sky-700 dark:text-sky-300">Page <%= page %> of <%= totalPages %></span>
    <% if (page < totalPages) { %>
      <a href="?q=<%= encodeURIComponent(q) %>&page=<%= page + 1 %>" class="px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800">Next</a>
    <% } %>
  </div>
<% } %>
