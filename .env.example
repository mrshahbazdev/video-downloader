PORT=3000
SITE_TITLE=ClipVault
ADSENSE_CLIENT_ID=ca-pub-0000000000000000
# Contact details shown on About and Contact pages
CONTACT_EMAIL=contact@example.com
CONTACT_ADDRESS=""
# Optional: path to a persistent cookies.txt file for YouTube / other bot-blocked sites
YOUTUBE_COOKIES_PATH=
# Optional: path to a system yt-dlp binary (e.g. /home/ubuntu/.local/bin/yt-dlp)
YOUTUBE_DL_BINARY=
# Optional: full path to the Python interpreter for yt-dlp (e.g. /usr/bin/python3)
YOUTUBE_DL_PYTHON=
# Optional: proxy to route blocked sites through, e.g. socks5://127.0.0.1:1080 or http://user:pass@proxy:8080
PROXY_URL=

# Optional: set 'recaptcha' for Google reCAPTCHA v3, 'math' for a built-in math captcha, or 'none' to disable
CAPTCHA_MODE=
# Optional: secret used to sign built-in math captcha tokens (auto-generated if not set)
CAPTCHA_SECRET=
# Optional: Google reCAPTCHA v3 site/secret keys (only used when CAPTCHA_MODE=recaptcha)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
